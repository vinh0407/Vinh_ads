    "next": "^14.2.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.0",
