# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vinhads?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Secrets (64+ chars recommended)
JWT_SECRET="generate-strong-jwt-secret-here-at-least-64-characters-long"
JWT_REFRESH_SECRET="generate-strong-jwt-refresh-secret-here-at-least-64-characters"

# AES-256 Encryption Key (Exactly 32 characters)
ENCRYPTION_KEY="32-char-encryption-key-for-aes256"

# Google Gemini AI API
GEMINI_API_KEY="your-gemini-api-key-from-aistudio"

# Facebook OAuth
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_CALLBACK_URL="http://localhost:3000/api/facebook/callback"
FACEBOOK_API_VERSION="v25.0"

# Cloud Storage (Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_BUCKET="vinhads"
STORAGE_ACCESS_KEY="your-storage-access-key"
STORAGE_SECRET_KEY="your-storage-secret-key"
STORAGE_REGION="auto"

# App
PORT=3000
NODE_ENV="production"
FRONTEND_URL="http://localhost:3001"
