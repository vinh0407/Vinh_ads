# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vince_ai?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-change-in-production"

# Encryption (32 chars for AES-256)
ENCRYPTION_KEY="32-char-encryption-key-for-tokens!!"

# Facebook OAuth
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# AI Providers
GEMINI_API_KEY="your-gemini-api-key"
NEMOTRON_API_KEY="your-nemotron-api-key"
OPENCODE_API_KEY="your-opencode-api-key"

# Frontend URL
FRONTEND_URL="http://localhost:3001"

# App
PORT=3000
NODE_ENV=development